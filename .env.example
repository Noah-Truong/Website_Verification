# Secret used to sign session JWTs. Set to a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-secret-string

# Optional: Google PageSpeed Insights API key for higher rate limits.
# Lighthouse-based performance scoring works without a key (lower quota).
PAGESPEED_API_KEY=

# Optional: GitHub token to raise the repository inspection rate limit.
GITHUB_TOKEN=

# Required for LLM-assisted requirement analysis (judging client-document
# requirements against the live site). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional: override the model used for requirement analysis.
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
